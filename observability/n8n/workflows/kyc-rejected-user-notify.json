{
  "id": "78da9fe6-c16b-555e-b67d-2ced54000415",
  "name": "KYC Rejected — User Notify",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kyc-rejected",
        "responseMode": "onReceived",
        "responseCode": 200
      },
      "id": "kyc-rej-webhook",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "kyc-rejected"
    },
    {
      "parameters": {
        "jsCode": "const p = ($input.first().json.body ?? $input.first().json);\nreturn [{\n  json: {\n    to: p.user_email,\n    subject: 'Your identity verification could not be approved',\n    emailBody: `We were unable to approve your identity verification submission.\\n\\nReason: ${p.rejection_reason || 'Please contact support for details.'}\\n\\nYou may resubmit with corrected information. Log in to your account: ${'https://kiniela.uk'}\\n\\nIf you believe this is an error, please contact our support team.`\n  }\n}];"
      },
      "id": "kyc-rej-format",
      "name": "Format Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "toEmail": "={{$json.to}}",
        "subject": "={{$json.subject}}",
        "emailType": "text",
        "fromEmail": "={{ $env.N8N_SMTP_SENDER }}",
        "text": "={{$json.emailBody}}"
      },
      "id": "kyc-rej-email",
      "name": "Send User Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        650,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "TiFq2ldHfdDdhEvf",
          "name": "SMTP account"
        }
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Format Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Email": {
      "main": [
        [
          {
            "node": "Send User Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "n8n_version": "1.49.0"
  }
}
