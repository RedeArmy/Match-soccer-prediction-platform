# ── Clerk ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Session max age in seconds — must match auth.session_max_age_seconds in the
# backend system_params table. Used by SessionGuard to proactively sign out idle
# users without relying on an API call to trigger the 401 path. Default: 604800
# (7 days). Production is configured to 18000 (5 hours).
NEXT_PUBLIC_SESSION_MAX_AGE_SECONDS=604800
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── App public URL (required in production) ───────────────────────────────────
# Full origin (scheme + host + optional port) of the deployed frontend.
# Used by Next.js to validate the Origin header on Server Action requests,
# preventing CSRF. Must match the URL users navigate to in their browser.
# Example production value: https://quinielamundial.gt
# Omit for local development — falls back to http://localhost:3000.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ── PayPal ────────────────────────────────────────────────────────────────────
# Client ID from developer.paypal.com → My Apps → your app → Credentials.
# Use the Sandbox client ID for development/testing.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
# Client Secret — server-side only, never exposed to the browser.
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# ── Backend (server-side only — never exposed to the browser) ───────────────────
# In Docker: http://backend:8080
# In local dev: http://localhost:8080
BACKEND_INTERNAL_URL=http://localhost:8080

# ── API-Football (server-side only — never exposed to the browser) ───────────────
# API key from api-football.com (RapidAPI) or api-sports.io dashboard.
# Used by /api/live/today and /api/live/fixture/[id] route handlers to fetch
# live match data directly from API-Football v3.
# Leave empty in local dev to disable live feed (pages render with empty state).
FOOTBALL_API_KEY=your-api-football-key

# Base URL for the API-Football v3 endpoint. Defaults to the standard endpoint
# when not set. Override to point to a proxy, a staging environment, or a future
# API version without a code change.
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io

# FIFA World Cup 2026 league ID in API-Football. Defaults to 1 if not set.
# Verify at: https://v3.football.api-sports.io/leagues?name=World+Cup&type=Cup
FOOTBALL_LEAGUE_ID=1

# Tournament season year. Defaults to 2026 if not set.
FOOTBALL_SEASON=2026
