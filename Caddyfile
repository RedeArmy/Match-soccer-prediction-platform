# Caddyfile — HTTPS reverse proxy for Hetzner production server.
#
# Caddy automatically provisions and renews TLS certificates via Let's Encrypt.
# All four env vars must be set before starting Caddy (see server/setup.sh):
#   APP_DOMAIN      — frontend app domain,    e.g. app.example.com
#   API_DOMAIN      — backend API domain,     e.g. api.example.com
#   GRAFANA_DOMAIN  — Grafana dashboard,      e.g. grafana.example.com
#   N8N_DOMAIN      — n8n automation,         e.g. n8n.example.com
#   ACME_EMAIL      — Let's Encrypt contact,  e.g. admin@example.com
#
# Caddy reads {$VAR} placeholders from the environment. On the server the
# systemd unit loads /opt/wcq/.env via EnvironmentFile (see server/setup.sh).

{
    email {$ACME_EMAIL}
}

# ── Frontend application ──────────────────────────────────────────────────────
{$APP_DOMAIN} {
    encode gzip zstd

    reverse_proxy 127.0.0.1:3000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "camera=(), microphone=(), geolocation=()"
        -Server
    }
}

# ── Backend API ───────────────────────────────────────────────────────────────
{$API_DOMAIN} {
    encode gzip

    reverse_proxy 127.0.0.1:8080

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        -Server
    }
}

# ── Grafana ───────────────────────────────────────────────────────────────────
# Caddy basic-auth acts as a first layer in front of Grafana's own login.
# GRAFANA_CADDY_HASH must be a bcrypt hash generated with:
#   caddy hash-password   (then set the output as the env var value)
{$GRAFANA_DOMAIN} {
    basic_auth {
        admin {$GRAFANA_CADDY_HASH}
    }
    reverse_proxy 127.0.0.1:3001
}

# ── n8n automation ────────────────────────────────────────────────────────────
# Caddy basic-auth is a second layer on top of n8n's own auth.
# n8n has direct DB access, so this is the highest-risk service to expose.
# N8N_CADDY_HASH must be a bcrypt hash generated with:
#   caddy hash-password
{$N8N_DOMAIN} {
    basic_auth {
        admin {$N8N_CADDY_HASH}
    }
    reverse_proxy 127.0.0.1:5678
}
