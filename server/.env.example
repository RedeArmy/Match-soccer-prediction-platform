# server/.env.example — Production environment template for /opt/wcq/.env
#
# Copy this file to /opt/wcq/.env on the Hetzner server and fill in all values.
# Lines starting with # are comments. Do NOT commit the real .env to git.
#
# This file is read by:
#   - docker-compose.prod.yml          (app services)
#   - docker-compose.observability.yml (obs + n8n)
#   - Caddy systemd unit               (Caddyfile {$VAR} substitution)

# ── Image versions (updated automatically by GitHub Actions on each deploy) ───
# Seed with `latest` for initial setup; deploy.sh will replace with the SHA tag.
API_IMAGE=ghcr.io/redearmy/match-soccer-prediction-platform:latest
WORKER_IMAGE=ghcr.io/redearmy/match-soccer-prediction-platform-worker:latest
FRONTEND_IMAGE=ghcr.io/redearmy/match-soccer-prediction-platform-frontend:latest

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Use the Session-mode pooler URL from Supabase Dashboard → Settings → Database → Connection string
# Session mode (port 5432 on pooler host) supports advisory locks used by the scoring engine.
# The pooler uses a Supabase-managed TLS certificate. Place the CA cert at /opt/wcq/supabase-ca.crt
# (download from Supabase Dashboard → Project Settings → Database → SSL → Download certificate)
# and append sslrootcert=/certs/supabase-ca.crt to the DSN.
# Format: postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/certs/supabase-ca.crt
WCQ_DATABASE_DSN=postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/certs/supabase-ca.crt

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_password_here

# ── Application ───────────────────────────────────────────────────────────────
# Public URL of the frontend. Used for:
#   - CORS allowed origins (api container)
#   - WCQ_SERVER_APPBASEURL — Recurrente redirect URLs and email action/unsubscribe links
#   The BFF proxy on the frontend forwards /api/* to the backend, so a single
#   public URL covers both frontend routes (/balance) and API routes (/api/v1/*).
FRONTEND_PUBLIC_URL=https://app.example.com

# ── Clerk Auth ────────────────────────────────────────────────────────────────
# JWKS URL — Clerk Dashboard → API Keys → Advanced → JWKS URL
CLERK_JWKS_URL=https://<clerk-domain>/.well-known/jwks.json
# Backend webhook signing secret — Clerk Dashboard → Webhooks → <endpoint> → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_CHANGE_ME
# Frontend Clerk keys — Clerk Dashboard → API Keys
CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME
CLERK_SECRET_KEY=sk_live_CHANGE_ME

# ── Payments ──────────────────────────────────────────────────────────────────
# AES-256-GCM key for encrypting payout details at rest (64 hex chars)
# Generate: openssl rand -hex 32
PAYOUT_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars_here
RECURRENTE_API_KEY=CHANGE_ME
RECURRENTE_WEBHOOK_SECRET=CHANGE_ME
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com # Use the sandbox URL for testing; switch to https://api-m.paypal.com in production
PAYPAL_WEBHOOK_ID=CHANGE_ME
WCQ_PAYMENT_PAYPALWEBHOOKID=CHANGE_ME
PAYPAL_CLIENT_ID=CHANGE_ME
PAYPAL_CLIENT_SECRET=CHANGE_ME

# ── API-Football / match sync ─────────────────────────────────────────────────                                                                                                                                   
# API key from api-football.com (api-sports.io) dashboard.                                                                                                                                                         
# Used by the match-sync worker to poll fixture status and update match results.                                                                                                                                   
# Leave empty in local dev — the worker starts but logs a warning and skips sync.                                                                                                                                  
# Plan recommendation: Basic (7 500 req/day) or higher for tournament coverage. 

# FIFA World Cup 2026 identifiers in API-Football (used by the frontend live feed).
# Verify league ID at: GET /leagues?name=World+Cup&type=Cup&season=2026
FOOTBALL_API_KEY=CHANGE_ME
FOOTBALL_LEAGUE_ID=1
FOOTBALL_SEASON=2026

# Override the default API-Football v3 base URL. Leave empty for production.                                                                                                                                       
# Useful for pointing at a stub server during integration tests.                                                                                                                                                   
# WCQ_FOOTBALLPROVIDER_BASEURL=https://v3.football.api-sports.io 

# ── Email ─────────────────────────────────────────────────────────────────────
# Resend API key — Resend Dashboard → API Keys → Create API Key
# Required by the worker for transactional email delivery in production.
RESEND_API_KEY=re_CHANGE_ME
# HMAC-SHA256 key for one-click unsubscribe link signatures (CAN-SPAM / GDPR).
# Generate: openssl rand -hex 32
EMAIL_UNSUBSCRIBE_SECRET=CHANGE_ME_32_hex_chars_here
# "From" address stamped on all transactional emails sent by the worker via Resend.
# Must match a verified sender address or domain in your Resend dashboard.
# Format: Display Name <address@yourdomain.com>
WCQ_EMAIL_FROMADDRESS=World Cup Quiniela <noreply@example.com>

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate a VAPID key pair: npx web-push generate-vapid-keys
# The public key and subject are stored as system_params in the database (see below).
VAPID_PRIVATE_KEY=CHANGE_ME

# ── Storage (Supabase Storage — S3-compatible) ────────────────────────────────
# Create a bucket in Supabase Dashboard → Storage, then obtain S3 credentials
# from Supabase Dashboard → Project Settings → Storage → S3 Access Keys.
# "local" driver is rejected in production.
STORAGE_DRIVER=s3
WCQ_STORAGE_S3BUCKET=wcq-uploads
# Supabase Storage S3 endpoint: https://<project-ref>.supabase.co/storage/v1/s3
WCQ_STORAGE_S3ENDPOINT=https://CHANGE_ME.supabase.co/storage/v1/s3
WCQ_STORAGE_S3REGION=us-east-1
WCQ_STORAGE_S3ACCESSKEYID=CHANGE_ME
WCQ_STORAGE_S3SECRETKEY=CHANGE_ME

# ── n8n — core ───────────────────────────────────────────────────────────────
# Encryption key for stored n8n credentials — Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_32_hex_chars_here
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASS=CHANGE_ME_strong_password_here
# API key for backend → n8n REST API calls.
# Generate AFTER first n8n startup: n8n UI → Settings → n8n API → Create an API key
N8N_API_KEY=CHANGE_ME
# Owner user ID for workflow import (n8n 2.x requires owner assignment via SharedWorkflow).
# Obtain AFTER completing the setup wizard:
#   curl -s -H "X-N8N-API-KEY: <N8N_API_KEY>" https://<N8N_DOMAIN>/api/v1/users | python3 -m json.tool
# Copy the "id" field of the first (owner) user.
N8N_OWNER_USER_ID=CHANGE_ME
# Public-facing webhook base URL — shown in n8n UI for webhook nodes
N8N_WEBHOOK_URL=https://n8n.example.com/
N8N_PROTOCOL=https

# ── n8n — SMTP (used by all 15 notification workflows via emailSend nodes) ───
# Workflows read ADMIN_EMAIL / COMPLIANCE_EMAIL / APP_BASE_URL at runtime via
# $env.VAR (expressions) or process.env.VAR (Code nodes).
# In n8n self-hosted, $env.* maps directly to container env vars.
N8N_SMTP_HOST=smtp.example.com
N8N_SMTP_PORT=587
N8N_SMTP_USER=notifications@example.com
N8N_SMTP_PASS=CHANGE_ME
# "From" address on all outgoing notification emails
N8N_SMTP_SENDER=notifications@example.com
# Destination addresses referenced in workflow expressions
N8N_ADMIN_EMAIL=admin@example.com
N8N_COMPLIANCE_EMAIL=compliance@example.com
# Specialist recipients used by escalation and alert workflows
N8N_OPS_EMAIL=ops@example.com
N8N_SENIOR_COMPLIANCE_EMAIL=senior-compliance@example.com
N8N_SANCTIONS_COMPLIANCE_EMAIL=sanctions@example.com
# Base URL for admin deep-links in KYC/compliance emails (e.g. /admin/kyc/queue).
# Defaults to FRONTEND_PUBLIC_URL when left empty; override only if the admin
# panel is hosted on a separate domain.
N8N_ADMIN_BASE_URL=

# ── n8n — webhook HMAC signing ────────────────────────────────────────────────
# HMAC-SHA256 key for backend → n8n webhook calls (X-Signature header).
# Must match WCQ_N8N_WEBHOOKSECRET in the backend.
# Generate: openssl rand -hex 32
N8N_WEBHOOK_SECRET=CHANGE_ME_32_hex_chars_here
# Shared key for n8n → backend scheduled calls (Authorization: Bearer <key>).
# Used by kyc-review-reminder and other scheduled workflows that poll /internal/* routes.
# Must match WCQ_N8N_INTERNALKEY on the api and worker containers.
# Generate: openssl rand -hex 32
N8N_INTERNAL_API_KEY=CHANGE_ME_32_hex_chars_here

# ── Observability ─────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_password_here
GRAFANA_ROOT_URL=https://grafana.example.com
# Distributed tracing — set ENABLED=true and point OTLPENDPOINT at Tempo.
# The endpoint must include the scheme: http://tempo:4318  (NOT http://http://tempo:4318).
# WCQ_TRACING_ENABLED=true
# WCQ_TRACING_OTLPENDPOINT=http://tempo:4318
# Use the production Prometheus config (scrapes by container name, not host.docker.internal)
PROMETHEUS_CONFIG=prometheus.prod.yml

# ── Caddy / TLS (also read by the Caddy systemd unit via EnvironmentFile) ─────
ACME_EMAIL=admin@example.com
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
GRAFANA_DOMAIN=grafana.example.com
N8N_DOMAIN=n8n.example.com

# =============================================================================
# GitHub Actions Secrets & Variables — complete table for automated deploys
# =============================================================================
# Configure under: Repository → Settings → Secrets and variables → Actions
#
# ── SECRETS (encrypted, never visible in logs) ────────────────────────────────
#
# ┌──────────────────────────────────┬────────────────────────────────────────────────────────┐
# │ Name                             │ Value / How to obtain                                  │
# ├──────────────────────────────────┼────────────────────────────────────────────────────────┤
# │ HETZNER_SSH_HOST                 │ Server IP address                                      │
# │ HETZNER_SSH_USER                 │ SSH username (e.g. deploy)                             │
# │ HETZNER_SSH_KEY                  │ Private SSH key in PEM format                          │
# │ HETZNER_SSH_KNOWN_HOST           │ Output of: ssh-keyscan <server-ip>                     │
# └──────────────────────────────────┴────────────────────────────────────────────────────────┘
#
# ── VARIABLES (plaintext, visible in logs — do not put secrets here) ──────────
#
# ┌──────────────────────────────────┬────────────────────────────────────────────────────────┐
# │ Name                             │ Value                                                  │
# ├──────────────────────────────────┼────────────────────────────────────────────────────────┤
# │ HETZNER_DEPLOY_ENABLED           │ true  — set to false to pause deploys                  │
# │ NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY│ pk_live_... — baked into the frontend image at build   │
# └──────────────────────────────────┴────────────────────────────────────────────────────────┘
#
# Notes:
#   GITHUB_TOKEN (automatic) — used for GHCR login; no secret needed.
#   The .env values above (Postgres password, n8n keys, SMTP, etc.) live ONLY on
#   the server in /opt/wcq/.env and are NOT stored as GitHub secrets.
#   Only the 5 values in the tables above are needed in GitHub.
#
# How to get HETZNER_SSH_KNOWN_HOST:
#   ssh-keyscan <server-ip>
#   Copy the full multi-line output into the secret value.
