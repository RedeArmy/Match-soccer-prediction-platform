# server/.env.example — Production environment template for /opt/wcq/.env
#
# Copy this file to /opt/wcq/.env on the Hetzner server and fill in all values.
# Lines starting with # are comments. Do NOT commit the real .env to git.
#
# This file is read by:
#   - docker-compose.prod.yml          (app services)
#   - docker-compose.observability.yml (obs + n8n)
#   - Caddy systemd unit               (Caddyfile {$VAR} substitution)

# ── Image versions (updated automatically by GitHub Actions on each deploy) ───
# Seed with `latest` for initial setup; deploy.sh will replace with the SHA tag.
API_IMAGE=ghcr.io/redearmy/match-soccer-prediction-platform:latest
WORKER_IMAGE=ghcr.io/redearmy/match-soccer-prediction-platform-worker:latest
FRONTEND_IMAGE=ghcr.io/redearmy/match-soccer-prediction-platform-frontend:latest

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Use the Session-mode pooler URL from Supabase Dashboard → Settings → Database → Connection string
# Session mode (port 5432 on pooler host) supports advisory locks used by the scoring engine.
# Format: postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
# For running migrations locally against Supabase, use the direct connection instead:
#   postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
WCQ_DATABASE_DSN=postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_password_here

# ── Application ───────────────────────────────────────────────────────────────
FRONTEND_PUBLIC_URL=https://app.example.com

# ── Clerk Auth ────────────────────────────────────────────────────────────────
# JWKS URL — Clerk Dashboard → API Keys → Advanced → JWKS URL
CLERK_JWKS_URL=https://<clerk-domain>/.well-known/jwks.json
# Backend webhook signing secret — Clerk Dashboard → Webhooks → <endpoint> → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_CHANGE_ME
# Frontend Clerk keys — Clerk Dashboard → API Keys
CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME
CLERK_SECRET_KEY=sk_live_CHANGE_ME

# ── Payments ──────────────────────────────────────────────────────────────────
# AES-256-GCM key for encrypting payout details at rest (64 hex chars)
# Generate: openssl rand -hex 32
PAYOUT_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars_here
RECURRENTE_API_KEY=CHANGE_ME
RECURRENTE_WEBHOOK_SECRET=CHANGE_ME
PAYPAL_WEBHOOK_ID=CHANGE_ME
PAYPAL_CLIENT_ID=CHANGE_ME
PAYPAL_CLIENT_SECRET=CHANGE_ME

# ── Email ─────────────────────────────────────────────────────────────────────
# HMAC-SHA256 key for one-click unsubscribe link signatures (CAN-SPAM / GDPR).
# Generate: openssl rand -hex 32
EMAIL_UNSUBSCRIBE_SECRET=CHANGE_ME_32_hex_chars_here

# ── Storage ───────────────────────────────────────────────────────────────────
# Object storage backend. "local" is rejected in production.
# Options: s3, onedrive, gdrive
STORAGE_DRIVER=s3

# ── n8n — core ───────────────────────────────────────────────────────────────
# Encryption key for stored n8n credentials — Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_32_hex_chars_here
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASS=CHANGE_ME_strong_password_here
# API key for backend → n8n REST API calls.
# Generate AFTER first n8n startup: n8n UI → Settings → n8n API → Create an API key
N8N_API_KEY=CHANGE_ME
# Public-facing webhook base URL — shown in n8n UI for webhook nodes
N8N_WEBHOOK_URL=https://n8n.example.com/
N8N_PROTOCOL=https

# ── n8n — SMTP (used by all 15 notification workflows via emailSend nodes) ───
# Workflows read ADMIN_EMAIL / COMPLIANCE_EMAIL / APP_BASE_URL at runtime via
# $env.VAR (expressions) or process.env.VAR (Code nodes).
# In n8n self-hosted, $env.* maps directly to container env vars.
N8N_SMTP_HOST=smtp.example.com
N8N_SMTP_PORT=587
N8N_SMTP_USER=notifications@example.com
N8N_SMTP_PASS=CHANGE_ME
# "From" address on all outgoing notification emails
N8N_SMTP_SENDER=notifications@example.com
# Destination addresses referenced in workflow expressions
N8N_ADMIN_EMAIL=admin@example.com
N8N_COMPLIANCE_EMAIL=compliance@example.com

# ── n8n — webhook HMAC signing ────────────────────────────────────────────────
# HMAC-SHA256 key for backend → n8n webhook calls (X-Signature header).
# Must match WCQ_N8N_WEBHOOKSECRET in the backend.
# Generate: openssl rand -hex 32
N8N_WEBHOOK_SECRET=CHANGE_ME_32_hex_chars_here

# ── Observability ─────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_password_here
GRAFANA_ROOT_URL=https://grafana.example.com
# Use the production Prometheus config (scrapes by container name, not host.docker.internal)
PROMETHEUS_CONFIG=prometheus.prod.yml

# ── Caddy / TLS (also read by the Caddy systemd unit via EnvironmentFile) ─────
ACME_EMAIL=admin@example.com
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
GRAFANA_DOMAIN=grafana.example.com
N8N_DOMAIN=n8n.example.com

# =============================================================================
# GitHub Actions Secrets & Variables — complete table for automated deploys
# =============================================================================
# Configure under: Repository → Settings → Secrets and variables → Actions
#
# ── SECRETS (encrypted, never visible in logs) ────────────────────────────────
#
# ┌──────────────────────────────────┬────────────────────────────────────────────────────────┐
# │ Name                             │ Value / How to obtain                                  │
# ├──────────────────────────────────┼────────────────────────────────────────────────────────┤
# │ HETZNER_SSH_HOST                 │ Server IP address                                      │
# │ HETZNER_SSH_USER                 │ SSH username (e.g. deploy)                             │
# │ HETZNER_SSH_KEY                  │ Private SSH key in PEM format                          │
# │ HETZNER_SSH_KNOWN_HOST           │ Output of: ssh-keyscan <server-ip>                     │
# └──────────────────────────────────┴────────────────────────────────────────────────────────┘
#
# ── VARIABLES (plaintext, visible in logs — do not put secrets here) ──────────
#
# ┌──────────────────────────────────┬────────────────────────────────────────────────────────┐
# │ Name                             │ Value                                                  │
# ├──────────────────────────────────┼────────────────────────────────────────────────────────┤
# │ HETZNER_DEPLOY_ENABLED           │ true  — set to false to pause deploys                  │
# │ NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY│ pk_live_... — baked into the frontend image at build   │
# └──────────────────────────────────┴────────────────────────────────────────────────────────┘
#
# Notes:
#   GITHUB_TOKEN (automatic) — used for GHCR login; no secret needed.
#   The .env values above (Postgres password, n8n keys, SMTP, etc.) live ONLY on
#   the server in /opt/wcq/.env and are NOT stored as GitHub secrets.
#   Only the 5 values in the tables above are needed in GitHub.
#
# How to get HETZNER_SSH_KNOWN_HOST:
#   ssh-keyscan <server-ip>
#   Copy the full multi-line output into the secret value.
