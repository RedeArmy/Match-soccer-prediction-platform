# ══════════════════════════════════════════════════════════════════════════════
# World Cup Quiniela — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in the values for your local environment:
#
#   cp .env.example .env
#
# NEVER commit .env to version control. It is listed in .gitignore.
# In production, inject these variables via your secrets manager
# (AWS Secrets Manager, HashiCorp Vault, GCP Secret Manager, etc.).
#
# Variable naming convention: WCQ_<SECTION>_<KEY>
# Nested config keys use a flat underscore separator, e.g.:
#   config key  "server.readTimeout"  →  env var  WCQ_SERVER_READTIMEOUT
#
# ══════════════════════════════════════════════════════════════════════════════

# ── Runtime environment ───────────────────────────────────────────────────────
# Set to dev for local development. Any non-dev value is treated as a deployed
# environment and requires Clerk auth/webhook configuration.
WCQ_ENVIRONMENT=dev

# ── HTTP Server ───────────────────────────────────────────────────────────────
WCQ_SERVER_PORT=8080

# Timeout for reading the full request, including body.
# Increase for endpoints that accept large file uploads.
WCQ_SERVER_READTIMEOUT=10s

# Timeout for writing the complete response.
# Must be longer than the slowest handler (e.g. a full ranking recalculation).
WCQ_SERVER_WRITETIMEOUT=30s

# Timeout for idle keep-alive connections.
# Should align with your load balancer's idle timeout setting.
WCQ_SERVER_IDLETIMEOUT=60s

# Network interface the Prometheus /metrics server binds to (default: all interfaces).
# Leave empty when Prometheus scrapes from a separate container or Fly.io private network.
# Set to "127.0.0.1" when Prometheus runs on the same host to restrict access to loopback.
# WCQ_SERVER_METRICSBINDADDR=127.0.0.1

# ── PostgreSQL Docker container ───────────────────────────────────────────────
# These variables are read by docker-compose.yml to configure the local
# Postgres container. Change them if you are sharing a Postgres instance
# across multiple projects on the same machine to avoid name collisions.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Override if port 5432 is already used by a system-managed Postgres instance.
# Must match the port in WCQ_DATABASE_DSN below.
POSTGRES_HOST_PORT=5432

# ── PostgreSQL Database ───────────────────────────────────────────────────────
# LOCAL DEVELOPMENT ONLY — sslmode=disable is rejected by the startup validator
# outside the dev environment. For production (or any non-dev environment) use:
#   WCQ_DATABASE_DSN=postgres://<user>:<password>@<host>:5432/<dbname>?sslmode=require
# For strict certificate verification (recommended on Fly.io with managed Postgres):
#   WCQ_DATABASE_DSN=postgres://<user>:<password>@<host>:5432/<dbname>?sslmode=verify-full
# Must match the POSTGRES_* values above for local development.
WCQ_DATABASE_DSN=postgres://<user>:<password>@localhost:5432/<dbname>?sslmode=disable

# Maximum number of open connections to the database server.
# Set this below the database server's max_connections limit.
# A typical starting point is: (number_of_api_pods × 25) < max_connections.
WCQ_DATABASE_MAXOPENCONNS=25

# Minimum number of connections kept open between traffic bursts.
# Prevents cold-start latency when the pool has drained completely.
WCQ_DATABASE_MAXIDLECONNS=5

# Maximum age of a connection before it is closed and replaced.
# Helps distribute connections evenly across database replicas
# and prevents accumulation of long-lived connections on the server.
WCQ_DATABASE_CONNMAXLIFETIME=5m

# ── Redis ─────────────────────────────────────────────────────────────────────
WCQ_REDIS_ADDR=localhost:6379

# Leave empty if your Redis instance does not require authentication.
WCQ_REDIS_PASSWORD=

# Redis logical database index (0–15). Use 0 unless you are sharing
# a Redis instance across multiple applications.
WCQ_REDIS_DB=0

# ── Logger ────────────────────────────────────────────────────────────────────
# Level: debug | info | warn | error
# Use "debug" locally to see all internal operations.
# Use "info" or "warn" in production to reduce log volume.
WCQ_LOGGER_LEVEL=info

# Encoding: json | console
# Use "console" locally for human-readable, coloured output.
# Use "json" in production so that log aggregation tools can parse fields.
WCQ_LOGGER_ENCODING=console

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to make cross-origin requests.
# In production, set this to your exact frontend domain (e.g. https://myapp.com).
# Never use a wildcard in production with credentialed requests.
WCQ_CORS_ALLOWEDORIGINS=http://localhost:3000

# ── Clerk Authentication ──────────────────────────────────────────────────────
# JWKS endpoint published by Clerk. Found in the Clerk dashboard under
# API Keys → Advanced → JWKS URL.
# Format: https://<your-clerk-frontend-api>/.well-known/jwks.json
WCQ_CLERK_JWKSURL=

# Svix webhook signing secret from Clerk.
# Required outside development to prevent unauthenticated user-sync calls.
#
# IMPORTANT — sandbox vs. production:
# Clerk creates separate applications (and separate webhook endpoints) for
# development and production. Each environment has its own signing secret.
# Never copy a sandbox secret to production or vice versa:
#   • Sandbox secret:    found under clerk.com → Development → Webhooks
#   • Production secret: found under clerk.com → Production  → Webhooks
# Rotating the wrong secret will silently break user-sync webhooks.
WCQ_CLERK_WEBHOOKSECRET=

# Optional: expected "iss" claim on every incoming JWT (defence-in-depth).
# Found in the Clerk dashboard under API Keys → Advanced → Issuer.
# Leave empty to skip issuer validation (safe default; a JWKS endpoint is
# already specific to one Clerk instance). Set this if that instance is ever
# shared by more than one Clerk "application", so a token issued for a
# sibling application is rejected here instead of silently accepted.
WCQ_CLERK_ISSUER=

# ── Payment / payout encryption ───────────────────────────────────────────────
# AES-256-GCM key for encrypting payout_details (bank account numbers,
# PayPal emails) at rest in the withdrawal_requests table.
#
# Generate with:  openssl rand -hex 32
#
# Required outside development. In local dev, leave this empty and the
# application uses plaintext storage with a startup warning.
# Rotate by deploying a new key and running the re-encryption migration:
#   make migrate-payout-enc KEY=<new-hex-key>
WCQ_PAYMENT_PAYOUTENCRYPTIONKEY=

# ── PayPal API credentials ──────────────────────────────────────────────────
# REST app credentials from the PayPal Developer Dashboard (Apps & Credentials).
# Required outside development; without these, POST /api/v1/paypal/create-order
# returns 503 "PayPal no está configurado en el servidor".
#
# PAYPAL_BASE_URL selects the PayPal environment:
#   Sandbox (test):  https://api-m.sandbox.paypal.com
#   Live (production): https://api-m.paypal.com   ← default when unset in prod
# Using sandbox credentials against the live URL returns 401 → 502 to the client.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
WCQ_PAYMENT_PAYPALCLIENTID=
WCQ_PAYMENT_PAYPALCLIENTSECRET=

# ── Webhook secrets ───────────────────────────────────────────────────────────
# Recurrente: Svix signing secret from Configuración → Desarrolladores y API → Webhooks.
# Format: whsec_<base64>  (copy the full string including the "whsec_" prefix).
# Leave empty in local dev to enable bypass mode (all webhooks accepted without verification).
WCQ_PAYMENT_RECURRENTEWEBHOOKSECRET=
WCQ_PAYMENT_PAYPALWEBHOOKID=

# ── Docker Compose (postgres/redis containers) ────────────────────────────────
POSTGRES_DB=quiniela
POSTGRES_USER=quiniela
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Clerk keys for the frontend — copy from Clerk dashboard
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_...

# Public URL of the frontend (used in CORS allowed origins)
FRONTEND_PUBLIC_URL=https://yourdomain.com

# Public URL of Grafana — used to embed it in the admin observability panel.
# Grafana is already exposed via $GRAFANA_DOMAIN in the Caddyfile.
# Must also be added as a GitHub Actions Variable (NEXT_PUBLIC_GRAFANA_URL)
# so it is baked into the Next.js bundle at build time.
GRAFANA_PUBLIC_URL=https://grafana.yourdomain.com

# ── Caddy basic-auth for admin tools (Grafana + n8n) ─────────────────────────
# Caddy sits in front of both services as a first-layer access control.
# Generate a bcrypt hash for each tool with:  caddy hash-password
# Then paste the full output (e.g. $2a$14$...) as the value below.
GRAFANA_CADDY_HASH=
N8N_CADDY_HASH=

# Grafana's own admin login (second layer, behind the Caddy basic-auth above).
# docker-compose.observability.yml has no fallback for this — it is deployed
# unchanged in both dev and production (see server/deploy.sh), so a baked-in
# default would be a real production credential, not a dev convenience.
GRAFANA_ADMIN_PASSWORD=

# Prometheus configuration file to load (default: prometheus.yml for local dev).
# MUST be set to prometheus.prod.yml in production — the dev config targets
# host.docker.internal which does not resolve in Linux Docker environments.
# Without this, Prometheus scrape targets are DOWN and Grafana shows NO DATA.
PROMETHEUS_CONFIG=prometheus.prod.yml

# ── API-Football (match sync) ─────────────────────────────────────────────────
# x-apisports-key credential from https://dashboard.api-football.com/profile?tab=credentials
# Without this key the match-sync worker starts but the provider client remains nil
# and sync is silently disabled. The worker logs a warning on startup when the key is absent.
#
# The base URL defaults to the production endpoint; override only for integration tests
# pointing at a local mock server.
#
# After setting the key, activate sync at runtime (no worker restart needed):
#   PATCH /api/v1/admin/params   {"match.sync.enabled": true}
#
# league_id=1 (FIFA World Cup) and season=2026 are already the compiled defaults;
# only override them if you are testing against a different competition.
WCQ_FOOTBALLPROVIDER_APIKEY=
# WCQ_FOOTBALLPROVIDER_BASEURL=https://v3.football.api-sports.io

# ── Exchange rate API keys (optional fallback sources) ────────────────────────
# WCQ_EXCHANGERATE_EXCHANGERATEAPIKEY=...
# WCQ_EXCHANGERATE_OPENEXCHANGERATESAPPID=...

# ── Resend (transactional email — worker only) ────────────────────────────────
# API key from https://resend.com/api-keys
# Required in production; without it the worker falls back to NoopClient and
# all user/admin emails are silently discarded.
RESEND_API_KEY=re_...

# Sender address stamped on every outgoing email.
# Must be a verified domain in your Resend account.
# Example: "World Cup Quiniela <noreply@quinielamundial.gt>"
WCQ_EMAIL_FROMADDRESS=World Cup Quiniela <noreply@yourdomain.com>

# HMAC-SHA256 secret for signing one-click email unsubscribe tokens (CAN-SPAM / GDPR).
# An empty value disables the unsubscribe link in outgoing emails.
# Generate with:  openssl rand -hex 32
EMAIL_UNSUBSCRIBE_SECRET=

# ── n8n (observability automation) ───────────────────────────────────────────
# n8n is started by docker-compose.observability.yml alongside Prometheus/Grafana.
# All variables below are consumed exclusively by the n8n container.

# ── n8n core ─────────────────────────────────────────────────────────────────
# Encryption key for n8n credential store (AES-256). REQUIRED — the compose
# file has no fallback default (this stack runs unchanged in production).
# Generate with:  openssl rand -hex 32
# WARNING: rotating this key invalidates all stored credentials in n8n.
N8N_ENCRYPTION_KEY=

# Basic-auth credentials for the n8n UI (http://n8n:5678 / N8N_DOMAIN).
# N8N_BASIC_AUTH_PASS is REQUIRED — no compose-level fallback. Pick a real
# value even for local dev; do not leave it as the literal word below.
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASS=changeme

# Public-facing URL n8n uses when generating webhook URLs in its UI.
# In production set to your HTTPS n8n domain, e.g. https://n8n.yourdomain.com/
# Required so that webhook trigger URLs shown in the n8n editor are reachable.
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/

# http or https (must match the scheme of N8N_WEBHOOK_URL).
N8N_PROTOCOL=https

# n8n REST API key — used by the backend admin panel to proxy calls to n8n
# (GET /api/admin/observability/n8n/*).
# Generate in n8n UI: Settings → n8n API → Create an API key.
N8N_API_KEY=

# HMAC-SHA256 shared secret for authenticating inbound webhook calls from the
# backend to n8n.  Must match WCQ_N8N_WEBHOOKSECRET on the api / worker.
# Generate with:  openssl rand -hex 32
N8N_WEBHOOK_SECRET=

# ── n8n SMTP ─────────────────────────────────────────────────────────────────
# SMTP credentials used by all emailSend nodes in the n8n workflows.
# n8n sends email independently of Resend; these are the SMTP relay credentials
# (e.g. Gmail relay, SendGrid SMTP, Brevo, Postmark, etc.).
N8N_SMTP_HOST=smtp.yourdomain.com
N8N_SMTP_PORT=587
N8N_SMTP_USER=
N8N_SMTP_PASS=
# "From" address for emails sent by n8n workflows.
N8N_SMTP_SENDER=noreply@yourdomain.com

# ── n8n workflow recipients ───────────────────────────────────────────────────
# Primary admin inbox — receives payment errors, DLQ overflow, circuit-breaker
# and bank-transfer upload alerts.
N8N_ADMIN_EMAIL=admin@yourdomain.com

# Compliance inbox — receives KYC submission, approval, and rejection notices.
N8N_COMPLIANCE_EMAIL=compliance@yourdomain.com

# Operations inbox — receives KYC queue overflow alerts.
N8N_OPS_EMAIL=ops@yourdomain.com

# Senior compliance officer — receives high-risk KYC escalation alerts.
N8N_SENIOR_COMPLIANCE_EMAIL=senior-compliance@yourdomain.com

# AML/Sanctions compliance officer — receives immediate sanctions-flag alerts.
# GDPR note: this address will receive PII (user ID, profile ID) in plaintext.
N8N_SANCTIONS_COMPLIANCE_EMAIL=sanctions@yourdomain.com

# ── n8n workflow URLs ─────────────────────────────────────────────────────────
# Deep-link base URL used in KYC/compliance email bodies
# (e.g. process.env.ADMIN_BASE_URL + "/admin/kyc/queue").
# Leave empty to default to FRONTEND_PUBLIC_URL.
# Override only when the admin panel lives on a separate domain.
N8N_ADMIN_BASE_URL=

# Internal backend URL for n8n → API calls (kyc-review-reminder scheduled workflow).
# Within Docker Compose this is always http://api:8080 — do not change unless
# n8n runs outside the Docker network.
N8N_API_BASE_URL=http://api:8080

# Shared secret for n8n → backend API calls (Authorization: Bearer <key>).
# The backend validates this key on routes polled by n8n scheduled workflows.
# Generate with:  openssl rand -hex 32
N8N_INTERNAL_API_KEY=
